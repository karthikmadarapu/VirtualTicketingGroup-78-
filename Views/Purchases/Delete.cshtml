@model VirtualTicketing.Models.Purchase

    <div class="container my-5">

    <div class="card border-0 shadow-lg p-4"
style="background-color: rgba(20, 0, 0, 0.85); border-radius: 16px;">

    <h2 class="fw-bold text-danger mb-4 text-center">
    Delete Purchase
    </h2>

    <p class="text-light text-center mb-4">
    Are you sure you want to delete this purchase?
    </p>

    <div class="border p-3 rounded bg-dark bg-opacity-50">
    <p class="text-secondary mb-1"><strong>Guest Name:</strong> @Model.GuestName</p>
    <p class="text-secondary mb-1"><strong>Email:</strong> @Model.GuestEmail</p>
    <p class="text-secondary mb-1">
    <strong>Total Paid:</strong>
    <span class="text-success">
    @Model.TotalCost.ToString("C", System.Globalization.CultureInfo.CreateSpecificCulture("en-CA"))
    </span>
    </p>
    <p class="text-secondary">
    <strong>Date:</strong>
    @Model.PurchaseDate.ToLocalTime().ToString("f")
    </p>
    </div>

    <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="mt-4 text-center">
    <button type="submit" class="btn btn-danger px-4 py-2 me-3">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary px-4 py-2">Cancel</a>
    </form>

    </div>

    </div>