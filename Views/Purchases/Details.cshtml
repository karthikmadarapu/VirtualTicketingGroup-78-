@model VirtualTicketing.Models.Purchase

<div class="container my-5">

    <div class="card border-0 shadow-lg p-4"
         style="background-color: rgba(15, 15, 30, 0.9); border-radius: 16px;">

        <h2 class="fw-bold text-primary mb-4 text-center">
            Purchase Details
        </h2>

        <div class="mb-4">
            <h5 class="text-light fw-semibold">Guest Information</h5>
            <p class="text-secondary mb-1"><strong>Name:</strong> @Model.GuestName</p>
            <p class="text-secondary"><strong>Email:</strong> @Model.GuestEmail</p>

            <p class="text-secondary">
                <strong>Date:</strong>
                <span class="text-info">
                    @Model.PurchaseDate.ToLocalTime().ToString("f")
                </span>
            </p>
        </div>

        <h5 class="text-light fw-semibold mt-4 mb-3">Purchased Tickets</h5>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle shadow-sm">
                <thead>
                    <tr class="text-center">
                        <th>Event</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="text-center">
                            <td>@item.Event.Name</td>
                            <td class="text-info">
                                @item.Price.ToString("C", System.Globalization.CultureInfo.CreateSpecificCulture("en-CA"))
                            </td>
                            <td>@item.Quantity</td>
                            <td class="text-success fw-bold">
                                @((item.Price * item.Quantity).ToString("C", System.Globalization.CultureInfo.CreateSpecificCulture("en-CA")))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-end mt-3">
            <h4 class="fw-bold text-light">
                Total Paid:
                <span class="text-success">
                    @Model.TotalCost.ToString("C", System.Globalization.CultureInfo.CreateSpecificCulture("en-CA"))
                </span>
            </h4>
        </div>

        <div class="mt-4 d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary px-4">Back</a>
            <a asp-action="Delete" asp-route-id="@Model.Id"
               class="btn btn-danger px-4">Delete</a>
        </div>

    </div>
</div>
