@model IEnumerable<VirtualTicketing.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-5 fade-in">

    <!-- 🔹 Alert Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert text-light p-3 rounded-4 mb-4 shadow-lg neon-border-red"
             style="background: rgba(255, 80, 100, 0.15); border: 1px solid #ff4f70; box-shadow: 0 0 15px #ff4f70;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert text-light p-3 rounded-4 mb-4 shadow-lg neon-border-green"
             style="background: rgba(60, 255, 180, 0.12); border: 1px solid #3ee8b5; box-shadow: 0 0 15px #3ee8b5;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- 🔹 Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0" style="color: #8cc9ff; text-shadow: 0 0 10px #4a90e2;">Categories 🎭</h2>
        <a class="btn btn-magic px-4 shadow-lg" asp-action="Create">
            <i class="bi bi-plus-lg me-2"></i> Create New
        </a>
    </div>

    <!-- 🔹 Category Table -->
    <div class="card border-0 shadow-lg rounded-4"
         style="background: rgba(20, 20, 40, 0.6); backdrop-filter: blur(8px);">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0 text-light">
                <thead style="background: rgba(255, 255, 255, 0.1); color: #9fc8ff;">
                    <tr>
                        <th class="fw-semibold ps-4">Name</th>
                        <th class="text-center" style="width: 250px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="transition: background 0.3s ease;">
                            <td class="ps-4">@item.Name</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-outline-warning btn-sm px-3 rounded-pill d-flex align-items-center me-1">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-outline-info btn-sm px-3 rounded-pill d-flex align-items-center me-1">
                                        <i class="bi bi-eye me-1"></i> Details
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm px-3 rounded-pill d-flex align-items-center">
                                        <i class="bi bi-trash3 me-1"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

