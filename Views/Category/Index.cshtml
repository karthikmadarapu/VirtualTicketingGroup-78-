@model IEnumerable<VirtualTicketing.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-5 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold mb-0">Categories 🎭</h2>
        <a class="btn btn-magic px-4 shadow-lg" asp-action="Create">
            <i class="bi bi-plus-lg me-2"></i> Create New
        </a>

    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="fw-semibold ps-4">Name</th>
                        <th class="text-center" style="width: 250px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">@item.Name</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-outline-warning btn-sm px-3 rounded-pill d-flex align-items-center me-1">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-outline-info btn-sm px-3 rounded-pill d-flex align-items-center me-1">
                                        <i class="bi bi-eye me-1"></i> Details
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm px-3 rounded-pill d-flex align-items-center">
                                        <i class="bi bi-trash3 me-1"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
