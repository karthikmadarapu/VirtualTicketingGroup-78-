@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">Welcome to VirtualTicketing 🎟️</h1>
        <p class="lead text-muted">
            Your one-stop destination to browse, purchase, and manage tickets for concerts, movies, and live events.
        </p>
        <a asp-controller="Event" asp-action="Index" class="btn btn-success btn-lg mt-3">
            View Events
        </a>

    </div>

    <div class="row text-center g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-ticket-perforated text-primary display-4 mb-3"></i>
                    <h5 class="card-title">Easy Booking</h5>
                    <p class="text-muted">Browse available events and book your tickets instantly.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-credit-card text-success display-4 mb-3"></i>
                    <h5 class="card-title">Secure Payments</h5>
                    <p class="text-muted">Your transactions are encrypted and processed securely.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-emoji-smile text-warning display-4 mb-3"></i>
                    <h5 class="card-title">Instant Confirmation</h5>
                    <p class="text-muted">Receive a digital confirmation right after your purchase.</p>
                </div>
            </div>
        </div>
    </div>
</div>